from collections.abc import Awaitable

def _activity() -> int: ...
def _shutdown() -> int: ...

class _Stream:
    def next(self) -> Awaitable[str | None]: ...
    def close(self) -> None: ...
    def _ahead(self) -> int | None: ...

class _Provider:
    @property
    def name(self) -> str: ...
    @property
    def model_name(self) -> str: ...
    @property
    def supports_vision(self) -> bool: ...
    @property
    def supports_streaming(self) -> bool: ...
    @property
    def supports_structured_streaming(self) -> bool: ...
    @property
    def supports_response_schema(self) -> bool: ...
    @property
    def supports_response_schema_with_tools(self) -> bool: ...
    @property
    def supports_deferred_tools(self) -> bool: ...
    @property
    def context_window(self) -> int | None: ...
    def catalog_entry_json(self) -> str | None: ...
    def list_models(self) -> Awaitable[str]: ...
    def generate(self, request_json: str, api_key: str | None) -> Awaitable[str]: ...
    def stream(self, request_json: str, api_key: str | None) -> _Stream: ...
    def close(self) -> Awaitable[None]: ...

# OpenAI.
def openai(config_json: str, api_key: str) -> _Provider: ...
def openai_config_form(config_json: str) -> str: ...
def openai_available_models_json() -> str: ...

class _OpenAIReplayWaits:
    def taken(self) -> list[float]: ...

def _openai_replaying(
    config_json: str, api_key: str, host: str, port: int, clock: float
) -> tuple[_Provider, _OpenAIReplayWaits]: ...

# A scripted provider of no vendor: only in a module built for the tests.
class _Scripted:
    def provider(self) -> _Provider: ...
    def asked_json(self) -> str: ...
    def keys(self) -> list[str | None]: ...
    def begun(self, count: int) -> Awaitable[None]: ...
    def dropped(self, count: int) -> Awaitable[None]: ...

def _scripted(script_json: str) -> _Scripted: ...
