import asyncio
from collections.abc import Awaitable
from typing import Any

from pydantic import SecretStr

# A module built for the tests holds more, declared nowhere: a scripted
# provider of no vendor, and what makes the bridge fail on purpose.

def _activity() -> int: ...
def _threads() -> tuple[int, int]: ...
def _handing() -> bool: ...
def _shutdown() -> int: ...

class _Stops:
    def __call__(self, future: asyncio.Future[Any]) -> None: ...

class _Stream:
    def next(self) -> Awaitable[str | None]: ...
    def close(self) -> None: ...
    def _ahead(self) -> int | None: ...

class _Provider:
    @property
    def name(self) -> str: ...
    @property
    def label(self) -> str: ...
    @property
    def model_name(self) -> str: ...
    @property
    def supports_vision(self) -> bool: ...
    @property
    def supports_streaming(self) -> bool: ...
    @property
    def supports_structured_streaming(self) -> bool: ...
    @property
    def supports_response_schema(self) -> bool: ...
    @property
    def supports_response_schema_with_tools(self) -> bool: ...
    @property
    def supports_deferred_tools(self) -> bool: ...
    @property
    def context_window(self) -> int | None: ...
    def catalog_entry_json(self) -> str | None: ...
    def managed_base_url(self) -> str: ...
    def managed_start(self) -> Awaitable[None]: ...
    def list_models(self) -> Awaitable[str]: ...
    def generate(self, request_json: str, api_key: str | None) -> Awaitable[str]: ...
    def stream(self, request_json: str, api_key: str | None) -> _Stream: ...
    def close(self) -> Awaitable[None]: ...

# What every provider's module is built with: `vendor` names the provider.
def provider(vendor: str, config_json: str, api_key: str | SecretStr | None) -> _Provider: ...
def config_form(vendor: str, config_json: str) -> str: ...
def catalogue(vendor: str) -> str: ...

class _ReplayWaits:
    def taken(self) -> list[float]: ...

def _replaying(
    vendor: str,
    config_json: str,
    api_key: str | SecretStr | None,
    host: str,
    port: int,
    clock: float,
) -> tuple[_Provider, _ReplayWaits]: ...
